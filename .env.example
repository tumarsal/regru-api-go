# оба формата эквивалентны (REGRU_* или без префикса):
# REGRU_AUTH=password
REGRU_USERNAME=your_username
REGRU_PASSWORD=your_password

# RSA-подпись (вместо пароля):
# REGRU_AUTH=signature
# REGRU_PRIVATE_KEY=/path/to/private.key

# клиентский TLS-сертификат (при загрузке cert в настройках API):
# REGRU_CERT_FILE=/path/to/client.crt
# REGRU_KEY_FILE=/path/to/private.key

# base_url=https://api.reg.ru
